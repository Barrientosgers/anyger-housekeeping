# Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders.

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/anyger

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace-me

# Error tracking (optional)
SENTRY_DSN=

# Text messages to the owner (Phase 4). SMS_PROVIDER: none (default, sending off) | fake | httpsms | twilio
SMS_PROVIDER=none
# Your dad's phone, in international format
NOTIFY_PHONE_NUMBER=
# Public address of the app, added to each text so one tap opens it
APP_URL=
# Safety limits: minimum minutes between texts of the same kind, and a hard monthly cap
SMS_COOLDOWN_MINUTES=10
SMS_MONTHLY_LIMIT=150
# httpSMS (free: an Android phone you own sends the text). HTTPSMS_FROM is that phone's number.
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# Twilio adapter (not used in production; not free beyond a trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase 5: AI translation
ANTHROPIC_API_KEY=

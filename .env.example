# Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders.

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/anyger

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace-me

# Rate limits need the visitor's real address. Set true ONLY when behind Cloudflare (Render is).
TRUST_CLOUDFLARE_IP=false

# Error tracking (optional)
SENTRY_DSN=

# Text messages to the owner (Phase 4). SMS_PROVIDER: none (default, sending off) | fake | httpsms | twilio
SMS_PROVIDER=none
# Your dad's phone, in international format
NOTIFY_PHONE_NUMBER=
# Public address of the app, added to each text so one tap opens it
APP_URL=
# Safety limits: minimum minutes between texts of the same kind, and a hard monthly cap
SMS_COOLDOWN_MINUTES=10
SMS_MONTHLY_LIMIT=150
# httpSMS (free: an Android phone you own sends the text). HTTPSMS_FROM is that phone's number.
HTTPSMS_API_KEY=
HTTPSMS_FROM=
# Twilio adapter (not used in production; not free beyond a trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Translation of client notes (Phase 5). TRANSLATE_PROVIDER: none (default) | fake | cloudflare | claude
TRANSLATE_PROVIDER=none
# App-wide cap on translations per day (protects the free allowance)
TRANSLATE_DAILY_LIMIT=200
# Cloudflare Workers AI (free; blocks instead of billing). LANG_FORMAT: code (en/es) or name (english/spanish)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LANG_FORMAT=code
# Claude API adapter (NOT free; off unless TRANSLATE_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

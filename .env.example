# Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders.

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/anyger

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace-me

# Error tracking (optional)
SENTRY_DSN=

# Phase 4: SMS provider
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_PHONE_NUMBER=

# Phase 5: AI translation
ANTHROPIC_API_KEY=
